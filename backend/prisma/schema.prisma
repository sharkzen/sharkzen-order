generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Table {
  id        String   @id @default(cuid())
  name      String   @unique
  seats     Int      @default(4)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id        String      @id @default(cuid())
  name      String
  price     Decimal     @db.Decimal(10, 2)
  available Boolean     @default(true)
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Order {
  id            String        @id @default(cuid())
  table         Table         @relation(fields: [tableId], references: [id])
  tableId       String
  status        OrderStatus   @default(NEW)
  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?
  stripeSessionId String?     @unique
  total         Decimal       @db.Decimal(10, 2)
  notes         String[]
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([tableId])
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId  String
  name        String
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  cancelledQty Int     @default(0)
  cancelReason String?

  @@index([orderId])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum AuthCodeType {
  EMAIL_OTP
  PASSWORD_RESET
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  firstName       String
  lastName        String
  passwordHash    String
  emailVerifiedAt DateTime?
  acceptedTermsAt DateTime
  marketingConsent Boolean     @default(false)
  plan            String?
  billingCycle    BillingCycle?
  authCodes       AuthCode[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

/// OTP ยืนยันอีเมล และ token รีเซ็ตรหัสผ่าน เก็บเฉพาะค่า hash ไม่เก็บรหัสจริง
model AuthCode {
  id         String       @id @default(cuid())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  type       AuthCodeType
  codeHash   String
  expiresAt  DateTime
  attempts   Int          @default(0)
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId, type])
  @@index([codeHash])
}
