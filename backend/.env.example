NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ต้องตรงกับ docker-compose.yml
DATABASE_URL="postgresql://sharkzen:sharkzen@localhost:5432/sharkzen_order?schema=public"

# origin ของ frontend (คั่นหลายตัวด้วย ,)
CORS_ORIGIN=http://localhost:3000

# URL ของ frontend ใช้เป็นปลายทางหลังจ่ายเงินที่ Stripe
FRONTEND_URL=http://localhost:3000

# Stripe (ใช้ sk_test_ ตอนพัฒนา) / whsec_ ได้จาก: stripe listen --forward-to localhost:3001/api/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# JWT session (สุ่มอย่างน้อย 32 ตัวอักษร: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"hex\"))")
JWT_SECRET=

# SMTP ตอนพัฒนาใช้ Mailpit (docker compose) ดูอีเมลที่ http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SHARKZEN ORDER <no-reply@sharkzen.local>"
