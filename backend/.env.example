NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ต้องตรงกับ docker-compose.yml
DATABASE_URL="postgresql://sharkzen:sharkzen@localhost:5432/sharkzen_order?schema=public"

# origin ของ frontend (คั่นหลายตัวด้วย ,)
CORS_ORIGIN=http://localhost:3000

# URL ของ frontend ใช้เป็นปลายทางหลังจ่ายค่าแพ็กเกจที่ Stripe
FRONTEND_URL=http://localhost:3000

# Stripe (ใช้ sk_test_ ตอนพัฒนา) / whsec_ ได้จาก: stripe listen --forward-to localhost:3001/api/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# JWT session (สุ่มอย่างน้อย 32 ตัวอักษร: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"hex\"))")
JWT_SECRET=

# SMTP ตอนพัฒนาใช้ Mailpit (docker compose) ดูอีเมลที่ http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SHARKZEN ORDER <no-reply@sharkzen.local>"

# Cloudflare R2 เก็บรูปเมนู (ระบบแปลงเป็น WebP ก่อนอัปโหลด และเก็บแค่ URL ในฐานข้อมูล)
# Account ID: Cloudflare dashboard > R2 > หน้า Overview (ขวามือ)
R2_ACCOUNT_ID=
# สร้างที่ R2 > Manage API tokens > Create API token (สิทธิ์ Object Read & Write เฉพาะ bucket นี้)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# โดเมนสาธารณะของ bucket (Custom Domain ของ bucket แนะนำ หรือ https://pub-xxxx.r2.dev ตอนพัฒนา) ห้ามมี / ท้าย
R2_PUBLIC_URL=

# --- ความปลอดภัยผู้ดูแลระบบ / หลังพร็อกซี (production) ---
# IP/CIDR ที่เข้า /api/admin ได้ คั่นด้วย , (ว่าง = ไม่จำกัด)
ADMIN_IP_ALLOWLIST=
# บังคับ 2FA ของผู้ดูแลระบบ (ค่าเริ่มต้น: true เฉพาะ NODE_ENV=production)
# ADMIN_REQUIRE_2FA=true
# อยู่หลัง nginx/Caddy/Cloudflare ให้ตั้ง true เพื่อให้ได้ IP จริง (ไม่งั้น allowlist และ rate limit ใช้ IP ของพร็อกซี)
TRUST_PROXY=false
