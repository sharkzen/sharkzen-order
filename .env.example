# ไฟล์นี้ใช้บน VPS เท่านั้น: คัดลอกเป็น .env (โฟลเดอร์เดียวกับ docker-compose.prod.yml) แล้วกรอกค่าจริง
# .env ห้าม commit (อยู่ใน .gitignore แล้ว)
#
# หลังจากนั้นทุกครั้งที่อัปเดตระบบ แค่:  git pull && docker compose up -d --build

# ให้ `docker compose` ใช้ไฟล์ production โดยไม่ต้องใส่ -f
# (เครื่อง dev ไม่มีไฟล์ .env นี้ จึงยังใช้ docker-compose.yml ตัวเดิมที่มีแค่ Postgres/Mailpit)
COMPOSE_FILE=docker-compose.prod.yml

# โดเมนที่ชี้ A record มาที่ VPS (Caddy ขอใบรับรอง HTTPS ให้เอง ต้องเปิดพอร์ต 80/443)
SITE_DOMAIN=example.com

POSTGRES_USER=sharkzen
POSTGRES_PASSWORD=เปลี่ยนเป็นรหัสผ่านยาวๆที่สุ่มมา
POSTGRES_DB=sharkzen_order

# สุ่ม: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# แอดมินคนแรก: สร้างอัตโนมัติตอน deploy ครั้งแรกเท่านั้น (ถ้าอีเมลนี้มีอยู่แล้วจะไม่เปลี่ยนรหัสผ่าน)
# ใช้รหัสผ่านที่เดายาก! production บังคับตั้ง 2FA ตอนเข้าสู่ระบบครั้งแรก
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SHARKZEN ORDER <no-reply@example.com>"

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# IP/CIDR ที่เข้า /api/admin ได้ คั่นด้วย , (ว่าง = ไม่จำกัด แนะนำให้ตั้ง) เช่น 203.0.113.10,198.51.100.0/24
ADMIN_IP_ALLOWLIST=

BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24
